<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_tab"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/zyro_surface"
    app:cardCornerRadius="16dp"
    app:cardElevation="4dp"
    app:strokeColor="@color/cyber_card_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Tab Header (Favicon, Title, Close Button) -->
        <LinearLayout
            android:id="@+id/layout_tab_header"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:background="#1B1D21"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="6dp">

            <ImageView
                android:id="@+id/iv_tab_favicon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="Site Favicon"
                android:scaleType="centerInside"
                android:src="@drawable/ic_globe"
                app:tint="@color/zyro_teal" />

            <TextView
                android:id="@+id/tv_tab_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textColor="@color/zyro_text_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="Google Search" />

            <ImageButton
                android:id="@+id/btn_tab_close"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Close Tab"
                android:padding="5dp"
                android:src="@drawable/ic_close"
                app:tint="@color/zyro_text_secondary" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider_color" />

        <!-- Tab Web Page Thumbnail Preview Area -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="190dp">

            <!-- Real Rendered Web Page Screenshot Preview -->
            <ImageView
                android:id="@+id/iv_tab_thumbnail"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Page Preview"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <!-- Default / Zyro Home Preview Placeholder -->
            <LinearLayout
                android:id="@+id/layout_tab_empty_preview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/zyro_bg"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="12dp">

                <ImageView
                    android:id="@+id/iv_preview_logo"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:contentDescription="Zyro Browser"
                    android:src="@drawable/ic_shield"
                    app:tint="@color/zyro_orange" />

                <TextView
                    android:id="@+id/tv_tab_preview_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="sans-serif-bold"
                    android:text="Zyro Home"
                    android:textColor="@color/zyro_text_primary"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif"
                    android:text="⚡ Shields Active"
                    android:textColor="@color/zyro_teal"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Active Tab Visual Indicator Tag -->
            <TextView
                android:id="@+id/tv_active_tab_tag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_margin="8dp"
                android:background="@drawable/bg_tab_box"
                android:fontFamily="monospace"
                android:paddingStart="6dp"
                android:paddingTop="2dp"
                android:paddingEnd="6dp"
                android:paddingBottom="2dp"
                android:text="ACTIVE"
                android:textColor="@color/cyber_cyan"
                android:textSize="9sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </FrameLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
