<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/new_tab_dashboard"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/theme_window_bg"
    android:fillViewport="true"
    android:descendantFocusability="beforeDescendants"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:overScrollMode="ifContentScrolls">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:descendantFocusability="beforeDescendants"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="28dp"
        android:paddingEnd="16dp"
        android:paddingBottom="96dp">

        <!-- ================================================================= -->
        <!-- 1. HERO BRANDING & APP LOGO                                       -->
        <!-- ================================================================= -->
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <ImageView
                android:id="@+id/ntp_logo"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_gravity="center"
                android:contentDescription="@string/app_name"
                android:src="@mipmap/ic_launcher" />
        </FrameLayout>

        <TextView
            android:id="@+id/ntp_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.04"
            android:text="Zyro Browser"
            android:textColor="@color/theme_text_primary"
            android:textSize="23sp" />

        <!-- Live Shields Status Pill -->
        <LinearLayout
            android:id="@+id/pill_shields_live"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_explore_chip"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingTop="4dp"
            android:paddingEnd="10dp"
            android:paddingBottom="4dp">

            <View
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:background="@drawable/bg_radar_circle"
                android:backgroundTint="@color/cyber_green" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.03"
                android:text="SHIELDS ACTIVE • ULTRA FAST &amp; PRIVATE"
                android:textColor="@color/zyro_teal"
                android:textSize="10.5sp" />
        </LinearLayout>

        <!-- ================================================================= -->
        <!-- 2. HERO SEARCH BAR (VOICE SEARCH + QR + CLEAN DESIGN)             -->
        <!-- ================================================================= -->
        <LinearLayout
            android:id="@+id/ntp_search_pill"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_hero_search_pill"
            android:clickable="true"
            android:elevation="4dp"
            android:focusable="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="8dp">

            <!-- Search Engine Icon (Google) -->
            <ImageView
                android:id="@+id/iv_ntp_search_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="Search Engine"
                android:src="@drawable/ic_google" />

            <!-- Hint text -->
            <TextView
                android:id="@+id/tv_ntp_search_hint"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif"
                android:text="Search with Google or enter URL"
                android:textColor="@color/theme_text_secondary"
                android:textSize="14sp" />

            <!-- Voice Search Button -->
            <ImageButton
                android:id="@+id/btn_ntp_voice_search"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Voice Search"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_mic" />

            <!-- QR / Camera Search Button -->
            <ImageButton
                android:id="@+id/btn_ntp_qr_search"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="QR Code Scanner"
                android:padding="9dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_qr_code"
                app:tint="@color/theme_text_secondary" />
        </LinearLayout>

        <!-- ================================================================= -->
        <!-- 3. QUICK ACTION UTILITY HUB (Incognito, Bookmarks, History, DL)   -->
        <!-- ================================================================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:orientation="horizontal">

            <!-- Private / Incognito -->
            <LinearLayout
                android:id="@+id/btn_action_incognito"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="6dp">

                <FrameLayout
                    android:id="@+id/qa_incognito_bg"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_quick_action"
                    android:elevation="1dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_incognito"
                        app:tint="@color/zyro_orange" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tv_action_incognito"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="Private"
                    android:textColor="@color/theme_text_primary"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Bookmarks -->
            <LinearLayout
                android:id="@+id/btn_action_bookmarks"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="6dp">

                <FrameLayout
                    android:id="@+id/qa_bookmarks_bg"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_quick_action"
                    android:elevation="1dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_bookmark"
                        app:tint="@color/zyro_teal" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tv_action_bookmarks"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="Bookmarks"
                    android:textColor="@color/theme_text_primary"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- History -->
            <LinearLayout
                android:id="@+id/btn_action_history"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="6dp">

                <FrameLayout
                    android:id="@+id/qa_history_bg"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_quick_action"
                    android:elevation="1dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_history"
                        app:tint="@color/cyber_cyan" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tv_action_history"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="History"
                    android:textColor="@color/theme_text_primary"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Downloads -->
            <LinearLayout
                android:id="@+id/btn_action_downloads"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="6dp">

                <FrameLayout
                    android:id="@+id/qa_downloads_bg"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_quick_action"
                    android:elevation="1dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_download"
                        app:tint="@color/zyro_purple" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tv_action_downloads"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="Downloads"
                    android:textColor="@color/theme_text_primary"
                    android:textSize="11sp" />
            </LinearLayout>

        </LinearLayout>

        <!-- ================================================================= -->
        <!-- 4. BRAVE-STYLE PRIVACY SHIELDS METRICS CARD                       -->
        <!-- ================================================================= -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_shields_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="@color/theme_card_bg"
            app:cardCornerRadius="18dp"
            app:cardElevation="3dp"
            app:strokeColor="@color/theme_divider"
            app:strokeWidth="1dp">

            <LinearLayout
                android:id="@+id/ntp_stats_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="14dp"
                android:paddingEnd="16dp"
                android:paddingBottom="14dp">

                <!-- Shields Header Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_shield"
                        app:tint="@color/zyro_orange" />

                    <TextView
                        android:id="@+id/tv_shields_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-bold"
                        android:letterSpacing="0.02"
                        android:text="ZYRO PRIVACY SHIELDS"
                        android:textColor="@color/theme_text_primary"
                        android:textSize="11.5sp" />

                    <TextView
                        android:id="@+id/btn_shields_settings"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="Settings →"
                        android:textColor="@color/zyro_orange"
                        android:textSize="11sp" />
                </LinearLayout>

                <View
                    android:id="@+id/view_shields_divider"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="12dp"
                    android:background="@color/theme_divider" />

                <!-- 3 Stats Columns -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Trackers Blocked -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_stat_trackers"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-black"
                            android:text="48"
                            android:textColor="@color/zyro_orange"
                            android:textSize="21sp" />

                        <TextView
                            android:id="@+id/tv_shields_sub1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Trackers\nBlocked"
                            android:textAlignment="center"
                            android:textColor="@color/theme_text_secondary"
                            android:textSize="10.5sp" />
                    </LinearLayout>

                    <View
                        android:id="@+id/view_stat_divider_1"
                        android:layout_width="1dp"
                        android:layout_height="36dp"
                        android:background="@color/theme_divider" />

                    <!-- Bandwidth Saved -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_stat_bandwidth"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-black"
                            android:text="14.4 MB"
                            android:textColor="@color/zyro_teal"
                            android:textSize="21sp" />

                        <TextView
                            android:id="@+id/tv_shields_sub2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Bandwidth\nSaved"
                            android:textAlignment="center"
                            android:textColor="@color/theme_text_secondary"
                            android:textSize="10.5sp" />
                    </LinearLayout>

                    <View
                        android:id="@+id/view_stat_divider_2"
                        android:layout_width="1dp"
                        android:layout_height="36dp"
                        android:background="@color/theme_divider" />

                    <!-- Time Saved -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_stat_time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-black"
                            android:text="3.8 s"
                            android:textColor="@color/zyro_purple"
                            android:textSize="21sp" />

                        <TextView
                            android:id="@+id/tv_shields_sub3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Est. Time\nSaved"
                            android:textAlignment="center"
                            android:textColor="@color/theme_text_secondary"
                            android:textSize="10.5sp" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ================================================================= -->
        <!-- 5. TOP SITES / SPEED DIAL GRID                                    -->
        <!-- ================================================================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_favorites_header"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-bold"
                android:letterSpacing="0.05"
                android:text="FAVORITES"
                android:textColor="@color/theme_text_secondary"
                android:textSize="11.5sp" />

            <TextView
                android:id="@+id/btn_add_speed_dial"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:padding="4dp"
                android:text="+ Add Shortcut"
                android:textColor="@color/zyro_orange"
                android:textSize="11.5sp" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_speed_dial"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:nestedScrollingEnabled="false"
            android:overScrollMode="never" />

        <!-- ================================================================= -->
        <!-- 6. TRENDING & QUICK EXPLORE SECTION (ELIMINATES BLANK CANVAS!)     -->
        <!-- ================================================================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_sparkle"
                app:tint="@color/zyro_orange" />

            <TextView
                android:id="@+id/tv_explore_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="sans-serif-bold"
                android:letterSpacing="0.05"
                android:text="EXPLORE &amp; TRENDING"
                android:textColor="@color/theme_text_secondary"
                android:textSize="11.5sp" />
        </LinearLayout>

        <!-- Horizontal Scroll of Quick Category Chips -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chip_explore_ai"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_explore_chip"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="sans-serif-medium"
                    android:paddingStart="12dp"
                    android:paddingTop="7dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="7dp"
                    android:text="🤖 AI &amp; Tech"
                    android:textColor="@color/theme_text_primary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/chip_explore_news"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_explore_chip"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="sans-serif-medium"
                    android:paddingStart="12dp"
                    android:paddingTop="7dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="7dp"
                    android:text="📰 World News"
                    android:textColor="@color/theme_text_primary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/chip_explore_sports"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_explore_chip"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="sans-serif-medium"
                    android:paddingStart="12dp"
                    android:paddingTop="7dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="7dp"
                    android:text="🏏 Sports &amp; Cricket"
                    android:textColor="@color/theme_text_primary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/chip_explore_markets"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_explore_chip"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="sans-serif-medium"
                    android:paddingStart="12dp"
                    android:paddingTop="7dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="7dp"
                    android:text="📈 Crypto &amp; Finance"
                    android:textColor="@color/theme_text_primary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/chip_explore_deals"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_explore_chip"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="sans-serif-medium"
                    android:paddingStart="12dp"
                    android:paddingTop="7dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="7dp"
                    android:text="🔥 Top Deals"
                    android:textColor="@color/theme_text_primary"
                    android:textSize="12sp" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Trending Query Grid / Quick Search Cards -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Card 1 -->
                <LinearLayout
                    android:id="@+id/trend_card_1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_quick_action"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="⚡ Fast Search"
                        android:textColor="@color/zyro_orange"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/tv_trend_1_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="sans-serif-bold"
                        android:text="Latest AI Tech Updates"
                        android:textColor="@color/theme_text_primary"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Card 2 -->
                <LinearLayout
                    android:id="@+id/trend_card_2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_quick_action"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="📈 Live Updates"
                        android:textColor="@color/zyro_teal"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/tv_trend_2_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="sans-serif-bold"
                        android:text="Crypto &amp; Market News"
                        android:textColor="@color/theme_text_primary"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <!-- Card 3 -->
                <LinearLayout
                    android:id="@+id/trend_card_3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_quick_action"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="🏆 Sports Live"
                        android:textColor="@color/cyber_cyan"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/tv_trend_3_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="sans-serif-bold"
                        android:text="Live Cricket &amp; Scores"
                        android:textColor="@color/theme_text_primary"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Card 4 -->
                <LinearLayout
                    android:id="@+id/trend_card_4"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_quick_action"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="🎬 Trending"
                        android:textColor="@color/zyro_purple"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/tv_trend_4_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="sans-serif-bold"
                        android:text="New Movies &amp; Trailers"
                        android:textColor="@color/theme_text_primary"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>

        <!-- ================================================================= -->
        <!-- 7. PRIVACY INSIGHT TIP CARD                                       -->
        <!-- ================================================================= -->
        <LinearLayout
            android:id="@+id/card_zero_trace"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_explore_chip"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_shield"
                app:tint="@color/zyro_teal" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_zero_trace_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-bold"
                    android:text="Zero-Trace Navigation Active"
                    android:textColor="@color/theme_text_primary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tv_zero_trace_desc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:lineSpacingExtra="1dp"
                    android:text="Built-in Zyro Shields strips tracking parameters, URL beacons, and blocks crypto-miners on every page."
                    android:textColor="@color/theme_text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
